# 벤치마크 산출물 (실행 결과, 코드 아님)
bench_out/

# 웹 실행 산출물
.arc-store/
drafts/

# 프런트엔드 (web/) — 빌드 산출물과 의존성. 소스와 lockfile은 추적한다.
web/node_modules/
web/.next/
web/out/
web/next-env.d.ts

# 리포트 코퍼스 — 외부 PDF 원본과 캐시는 제외, 색인/노트/README는 추적
corpus/**/*.pdf
corpus/**/text/
corpus/**/prices/

# 사용자가 대화에 붙인 스크린샷. 구독 채널·동료 이름이 찍혀 있어 저장소에 안 올린다.
docs/KakaoTalk_Photo_*

# 텔레그램 세션 = 계정 접근권 그 자체. 절대 커밋하지 않는다.
*.session
*.session-journal
.arc-backup-*

# 에이전트 워크트리 — 저장소 안의 저장소다. 커밋에 딸려 들어가면 안 된다
.claude/worktrees/
