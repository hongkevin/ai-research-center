#!/bin/sh
# 커밋 직전 비밀키 검사.
#
# 이 저장소에서 실제로 두 번 일어난 일이다 — `.env.example`에 진짜 키를 넣고
# 커밋할 뻔했다. 저장소가 public이라 푸시되면 그 즉시 노출된다.
# CI도 검사하지만 CI는 **푸시된 뒤**라 늦다. 여기서 막는다.
#
# 설치: git config core.hooksPath .githooks

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

# 스테이징된 내용에서만 찾는다 (working tree 아님)
hits=$(git diff --cached -U0 -- $staged \
  | grep -E '^\+' \
  | grep -nE 'sk-proj-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9]{40,}|crtfc_key=[a-f0-9]{40}' \
  || true)

if [ -n "$hits" ]; then
  echo "커밋을 막았습니다 — API 키로 보이는 문자열이 있습니다:"
  echo "$hits" | sed 's/\(.\{100\}\).*/\1…/' | head -5
  echo
  echo "실제 키는 .env 에만 둡니다 (.gitignore 대상)."
  echo ".env.example 에는 값을 비워 두십시오."
  exit 1
fi
exit 0
