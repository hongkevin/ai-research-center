# OpenDART — https://opendart.fss.or.kr (무료, 일 20,000건)
DART_API_KEY=

# 금융위 주식시세정보 API — https://www.data.go.kr (무료, EOD 시세)
KRX_API_KEY=

# 한국은행 ECOS — https://ecos.bok.or.kr/api (무료, 신청 즉시 발급)
#
# 브리프의 **매크로 칸**이 이 키로 돈다. 금융위 API에는 지수만 있고
# 환율·금리가 없다 — 원/달러, 국고채 3년·10년, 기준금리가 여기서 나온다.
ECOS_API_KEY=

# 네이버 뉴스 검색 API (무료, 일 25,000회)
#
# **2026-07-31부터 개발자센터에서는 신규 발급이 안 된다.** NAVER API HUB로
# 이관됐다 — https://www.ncloud.com/product/applicationService/naverApiHub
# (NCP 계정 필요). 새로 받으면 이쪽 키이고 기본 동작이 이쪽이다.
#
# 2027-06-30 이전에 개발자센터에서 받은 구 키를 아직 쓴다면 NAVER_API_MODE=legacy
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_MODE=hub

# Anthropic Claude API — https://platform.claude.com (S2·S4·S5 단계, 5~6주차부터)
ANTHROPIC_API_KEY=

# OpenAI API — https://platform.openai.com
# (설계 문서는 Claude 기준이나, 현재 사용 가능한 키에 맞춰 provider를 추상화했다)
OPENAI_API_KEY=

# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# https://platform.moonshot.ai
MOONSHOT_API_KEY=

# https://open.bigmodel.cn
ZHIPU_API_KEY=

# ── 로그인 (Supabase · Google 하나) ─────────────────────────────────
# 셋 다 넣으면 Basic Auth 대신 토큰 검증으로 전환된다 (web/auth.py).
# 비우면 ARC_PASSWORD의 공유 비밀번호로 돈다 — 전환기에는 둘 다 산다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 프로젝트 설정 → API → JWT Secret. **anon 키가 아니다.**
SUPABASE_JWT_SECRET=

# 텔레그램 수집기 (선택). https://my.telegram.org 에서 앱을 만들면 나온다.
# **봇 토큰이 아니다** — 봇은 남의 채널에 못 들어가고 히스토리도 못 읽는다.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
