# OpenDART — https://opendart.fss.or.kr (무료, 일 20,000건)
DART_API_KEY=

# 금융위 주식시세정보 API — https://www.data.go.kr (무료, EOD 시세)
KRX_API_KEY=

# 한국은행 ECOS — https://ecos.bok.or.kr/api (무료, 신청 즉시 발급)
#
# 브리프의 **매크로 칸**이 이 키로 돈다. 금융위 API에는 지수만 있고
# 환율·금리가 없다 — 원/달러, 국고채 3년·10년, 기준금리가 여기서 나온다.
ECOS_API_KEY=

# 네이버 뉴스 검색 API (무료, 일 25,000회)
#
# **2026-07-31부터 개발자센터에서는 신규 발급이 안 된다.** NAVER API HUB로
# 이관됐다 — https://www.ncloud.com/product/applicationService/naverApiHub
# (NCP 계정 필요). 새로 받으면 이쪽 키이고 기본 동작이 이쪽이다.
#
# 2027-06-30 이전에 개발자센터에서 받은 구 키를 아직 쓴다면 NAVER_API_MODE=legacy
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_MODE=hub

# Anthropic Claude API — https://platform.claude.com (S2·S4·S5 단계, 5~6주차부터)
ANTHROPIC_API_KEY=

# OpenAI API — https://platform.openai.com
# (설계 문서는 Claude 기준이나, 현재 사용 가능한 키에 맞춰 provider를 추상화했다)
OPENAI_API_KEY=

# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# https://platform.moonshot.ai
MOONSHOT_API_KEY=

# https://open.bigmodel.cn
ZHIPU_API_KEY=

# ── 로그인 (Supabase · Google 하나) ─────────────────────────────────
#
# 넣으면 Basic Auth 대신 토큰 검증으로 전환된다 (web/auth.py).
# 비우면 인증이 **꺼진 채** 뜬다 — 이 앱은 LLM 키를 들고 있으므로 공개
# 주소에 그 상태로 올리면 안 된다.
#
#   1. https://supabase.com 에서 프로젝트 생성
#   2. Settings → API Keys
#        Project URL   → NEXT_PUBLIC_SUPABASE_URL
#                        **https:// 와 .supabase.co 까지 전부** 넣는다.
#                        프로젝트 ref만 넣으면 JWKS 주소를 못 만든다
#        Publishable   → NEXT_PUBLIC_SUPABASE_ANON_KEY  (`sb_publishable_…`)
#                        legacy anon(`eyJ…`)도 아직 되지만 2026년 말 폐기다
#   3. Authentication → Providers → Google
#        Client ID / Client Secret 을 넣는다. 그 값은 Google Cloud에서 만든다:
#          console.cloud.google.com/auth/clients → Create → Web application
#            Authorized redirect URIs
#              https://<ref>.supabase.co/auth/v1/callback   ← **Supabase 주소다**
#              (provider 화면 맨 아래 Callback URL 과 같은 값)
#            Authorized JavaScript origins
#              http://localhost:8080                        ← 우리 앱 주소
#
#   4. Authentication → **URL Configuration**  ← 우리 앱으로 돌아올 주소는 여기다
#        Site URL       http://localhost:8080
#        Redirect URLs  http://localhost:8080/auth/callback/
#
#      **③과 ④를 헷갈리기 쉽다.** ③은 Google이 Supabase로 돌려보내는 주소이고,
#      ④는 Supabase가 우리 앱으로 돌려보내는 주소다. provider 화면에는 ④가 없다.
#
# **SUPABASE_JWT_SECRET은 보통 비워 둔다.**
# 지금 Supabase는 비대칭 서명키(ES256)가 기본이고 서버가 JWKS 공개키로
# 검증한다 — 공유 시크릿이 애초에 없다.
#   · Settings → JWT Keys 의 **Key ID(UUID)를 여기 넣으면 안 된다.** 그건
#     시크릿이 아니고, 넣으면 HS256 경로가 켜져 모든 토큰이 거부된다
#   · 예전에 만든 프로젝트에서 legacy HS256을 아직 쓸 때만 채운다
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# 로그인을 켜는 날, 켜기 전에 쌓인 `users/local/`을 **누가 가져갈지**.
#
#   비움 · 0   안 넘긴다. **공유 배포의 기본값이어야 한다**
#   이메일     그 사람만 (권하는 방식). 예: me@example.com
#   uid        그 사람만. 로그인해 보기 전에는 UUID를 모르니 대개 이메일이 편하다
#   1          먼저 로그인한 사람. 편하지만 **누가 될지는 운**이다
#
# 배포본이 인증 없이 돌던 동안 `users/local/`에 쌓였을 수 있다 —
# 그때는 `current_user()`가 `local`이었다. 그걸 남이 가져가면 안 된다.
#
# **자격증명(텔레그램 세션)은 안 따라간다.**
ARC_ADOPT_LOCAL=1

# 텔레그램 수집기 (선택). https://my.telegram.org 에서 앱을 만들면 나온다.
# **봇 토큰이 아니다** — 봇은 남의 채널에 못 들어가고 히스토리도 못 읽는다.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ── 개인 데이터 저장소 (선택) ───────────────────────────────────────
#
# 비우면 **파일로 돈다** — 로컬 개발과 테스트가 DB를 요구하면 안 된다.
# 넣으면 사건 로그가 Postgres로 간다 (D80).
#
# 대시보드 **맨 위의 「Connect」 버튼** → Connection String 탭
#   (예전 「Settings → Database」 경로가 아닙니다)
#
#   **Session pooler**를 고르십시오 — 셋 중 이것뿐입니다:
#     · Direct connection   db.<ref>.supabase.co:5432   IPv6 전용 → 국내 회선에선 안 됨
#     · Session pooler      aws-<region>.pooler.supabase.com:5432   ← 이것
#     · Transaction pooler  …:6543   prepared statement를 안 받아 psycopg와 안 맞음
#
#   `[YOUR-PASSWORD]` 자리에 **DB 비밀번호**를 넣습니다 (anon 키가 아닙니다).
#   잊었으면 Connect 창이나 Settings → Database에서 재설정할 수 있습니다.
#
# 넣은 뒤: `arc db check` → `arc db init` → `arc db migrate --uid local``
DATABASE_URL=
