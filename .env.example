# OpenDART — https://opendart.fss.or.kr (무료, 일 20,000건)
DART_API_KEY=

# 금융위 주식시세정보 API — https://www.data.go.kr (무료, EOD 시세)
KRX_API_KEY=

# 네이버 뉴스 검색 API — https://developers.naver.com (무료, 일 25,000회)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Anthropic Claude API — https://platform.claude.com (S2·S4·S5 단계, 5~6주차부터)
ANTHROPIC_API_KEY=

# OpenAI API — https://platform.openai.com
# (설계 문서는 Claude 기준이나, 현재 사용 가능한 키에 맞춰 provider를 추상화했다)
OPENAI_API_KEY=

# https://platform.deepseek.com
DEEPSEEK_API_KEY=

# https://platform.moonshot.ai
MOONSHOT_API_KEY=

# https://open.bigmodel.cn
ZHIPU_API_KEY=

# ── 로그인 (Supabase · Google 하나) ─────────────────────────────────
# 셋 다 넣으면 Basic Auth 대신 토큰 검증으로 전환된다 (web/auth.py).
# 비우면 ARC_PASSWORD의 공유 비밀번호로 돈다 — 전환기에는 둘 다 산다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 프로젝트 설정 → API → JWT Secret. **anon 키가 아니다.**
SUPABASE_JWT_SECRET=
